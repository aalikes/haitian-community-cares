{
  "name": "chess-coach",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Personal chess improvement coach: on-device Stockfish analysis, spoken explanations, animated board replays, and drills generated from your own mistakes.",
  "scripts": {
    "postinstall": "node scripts/copy-engine.mjs",
    "engine": "node scripts/copy-engine.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "chess.js": "^1.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "typescript": "^5.9.3",
    "vite": "^8.1.5"
  }
}
